{
  "description": "Each hook runs its sdd-helpers binary through hooks/run, which fetches the release this plugin names at SessionStart; sdd-grounding-gate holds a question, a draft edit and a graph write to real reads of the project's sdd graph (gate), notes the reads each call performed (record), forgets them after a compaction, sweeps old ledgers and starts the daily release prune (start), and removes the ending session's ledgers (end); sdd-grounding-gate collapse, after every sdd MCP tool, shortens an answer carrying sdd's structured fields to what the calling agent was not shown already, and sdd-grounding-gate spawn, on the Agent tool, keeps a fork its spawner's shown set; sdd-grounding-gate check, at session start, names what is off or misplaced on the machine and starts the daily release prune in every project",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run\" --session-start sdd-grounding-gate start", "timeout": 120 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run\" --session-start sdd-grounding-gate check", "timeout": 120 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|Write|Edit|NotebookEdit|Bash|Monitor|mcp__sdd__show|mcp__sdd__start_procedure|mcp__sdd__next|mcp__sdd__stage_attachment",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run\" sdd-grounding-gate gate", "timeout": 15 }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run\" sdd-grounding-gate spawn", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|mcp__sdd__search|mcp__sdd__view|mcp__sdd__start_procedure|mcp__sdd__next",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run\" sdd-grounding-gate record", "timeout": 15 }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run\" sdd-grounding-gate record", "timeout": 15 }
        ]
      },
      {
        "matcher": "mcp__sdd__stage_attachment",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run\" sdd-grounding-gate record", "timeout": 15 }
        ]
      },
      {
        "matcher": "mcp__sdd__.*",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run\" sdd-grounding-gate collapse", "timeout": 15 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run\" sdd-grounding-gate end", "timeout": 15 }
        ]
      }
    ]
  }
}
